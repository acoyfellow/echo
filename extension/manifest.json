{
  "manifest_version": 3,
  "name": "Echo Codemode",
  "version": "0.0.1",
  "description": "Give an agent temporary full JavaScript access to one approved browser tab.",
  "key": "",
  "permissions": ["activeTab", "alarms", "debugger", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_popup": "popup.html" }
}
